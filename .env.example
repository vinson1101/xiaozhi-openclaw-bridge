# Example only. Copy to .env, set real local values, then export before starting Bridge.
XOB_AGENT_TARGETS=hermes=hermes-cli:XOB_HERMES
XOB_HERMES_SSH_TARGET=example@192.0.2.10
XOB_HERMES_SSH_KEY=/absolute/path/to/hermes/key
XOB_HERMES_CLI_BIN=/home/example/xiaozhi-openclaw-bridge/scripts/hermes_cli_with_desktop_env.sh
XOB_HERMES_ENABLE_COMMANDS=1
